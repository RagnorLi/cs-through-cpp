  "cards": [
    {
      "dot": "cyan",
      "title": "关键顺序不可颠倒",
      "items": [
        "GoalService 持有 mutation permit，避免改状态时另一个 idle continuation 抢跑",
        "显式用户意图在数据库写入前进入 rollout；失败则 Goal 状态不变",
        "数据库成功后才响应、通知，并应用运行时效果"
      ]
    },
    {
      "dot": "amber",
      "title": "为什么不会抢你的话",
      "items": [
        "自动回合提交前、保留 turn 后都会检查待处理的用户触发输入",
        "已有 active turn 时返回 NotIdle；Plan 模式返回 PlanMode",
        "因此 Goal 是 idle 事件驱动，不是无条件后台循环"
      ]
    },
    {
      "dot": "violet",
      "title": "模型的权力不是无限的",
      "items": [
        "create_goal 只允许在用户明确要求时调用，且不能覆盖未结束 Goal",
        "update_goal 只暴露 complete / blocked / paused",
        "resume、budget_limited、usage_limited 由用户或系统控制"
      ]
    },
    {
      "dot": "emerald",
      "title": "完成到底意味着什么",
      "items": [
        "普通 assistant 最终文本不会自动把 Goal 标为 complete",
        "只有目标确实达成、逐项审计无遗漏后，模型才应调用 update_goal(complete)",
        "若仍 active，线程再次 idle 时会进入下一轮自动 continuation"
      ]
    }
  ]
}
