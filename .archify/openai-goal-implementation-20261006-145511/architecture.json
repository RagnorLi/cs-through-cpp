  "cards": [
    {
      "dot": "cyan",
      "title": "一句话本质",
      "items": [
        "/goal 不是一段神秘 Prompt，而是线程级持久状态 + 事件驱动续跑",
        "目标全文存在 SQLite；每次自动回合再把它渲染成内部上下文送入 Agent Loop",
        "线程不空闲、Plan 模式、已有用户触发输入时，自动回合会被拒绝"
      ]
    },
    {
      "dot": "emerald",
      "title": "真实持久字段",
      "items": [
        "thread_id · goal_id · objective · status",
        "token_budget · tokens_used · time_used_seconds",
        "created_at_ms · updated_at_ms；clear 是删行，不是第七种 status"
      ]
    },
    {
      "dot": "amber",
      "title": "事实分层",
      "items": [
        "公开源码：本图源码徽标全部固定到 commit 822e58c…",
        "官方文档：证明 Desktop 暴露 /goal 及同一线程级语义",
        "闭源边界：不声称知道 Desktop 输入框内部的具体函数名"
      ]
    },
    {
      "dot": "violet",
